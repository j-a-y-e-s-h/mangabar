{
  "name": "mangabar",
  "displayName": "MangaBar - Manga & Comic Reader",
  "description": "Read manga, manhwa, webtoons, and comics directly in your IDE sidebar or full editor tab. High-performance offline reader with Keiyoushi catalog (350+ sources), offline downloads, smooth zoom & pan, and dual-side docking.",
  "version": "0.2.0",
  "publisher": "j-a-y-e-s-h",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "mangabar",
    "manga",
    "manhwa",
    "webtoon",
    "comics",
    "comic-reader",
    "manga-reader",
    "keiyoushi",
    "mangadex",
    "offline-reader",
    "ide-reader",
    "developer-productivity"
  ],
  "badges": [
    {
      "url": "https://img.shields.io/badge/MangaBar-v0.2.0-00bcd4",
      "href": "https://github.com/j-a-y-e-s-h/mangabar",
      "description": "MangaBar Reader"
    },
    {
      "url": "https://img.shields.io/badge/License-MIT-4caf50",
      "href": "https://opensource.org/licenses/MIT",
      "description": "License: MIT"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/j-a-y-e-s-h/mangabar"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:mangabar.sidebarView",
    "onCommand:mangabar.openReader",
    "onCommand:mangabar.toggleReader",
    "onCommand:mangabar.toggleSidebar",
    "onCommand:mangabar.toggleSideBarLocation",
    "onCommand:mangabar.startServer"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mangabar-sidebar",
          "title": "MangaBar",
          "icon": "media/mangabar.svg"
        }
      ]
    },
    "views": {
      "mangabar-sidebar": [
        {
          "type": "webview",
          "id": "mangabar.sidebarView",
          "name": "MangaBar"
        }
      ]
    },
    "commands": [
      {
        "command": "mangabar.toggleReader",
        "title": "Toggle Full Reader",
        "category": "MangaBar",
        "icon": "$(book)"
      },
      {
        "command": "mangabar.toggleSidebar",
        "title": "Toggle MangaBar Sidebar",
        "category": "MangaBar",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "mangabar.toggleSideBarLocation",
        "title": "Toggle Side Bar Location (Left / Right)",
        "category": "MangaBar",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "mangabar.openReader",
        "title": "Open Full Reader",
        "category": "MangaBar",
        "icon": "$(screen-full)"
      },
      {
        "command": "mangabar.startServer",
        "title": "Start Server",
        "category": "MangaBar",
        "icon": "$(play)"
      },
      {
        "command": "mangabar.reloadView",
        "title": "Reload View",
        "category": "MangaBar",
        "icon": "$(refresh)"
      },
      {
        "command": "mangabar.restartServer",
        "title": "Restart Server",
        "category": "MangaBar",
        "icon": "$(sync)"
      },
      {
        "command": "mangabar.stopServer",
        "title": "Stop Server",
        "category": "MangaBar",
        "icon": "$(debug-stop)"
      },
      {
        "command": "mangabar.configureStorage",
        "title": "Change Storage Location",
        "category": "MangaBar",
        "icon": "$(folder)"
      },
      {
        "command": "mangabar.openWebBrowser",
        "title": "Open in External Browser",
        "category": "MangaBar",
        "icon": "$(globe)"
      }
    ],
    "keybindings": [
      {
        "command": "mangabar.toggleReader",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      },
      {
        "command": "mangabar.toggleSidebar",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mangabar.toggleSideBarLocation",
          "when": "view == mangabar.sidebarView",
          "group": "navigation@0"
        },
        {
          "command": "mangabar.reloadView",
          "when": "view == mangabar.sidebarView",
          "group": "navigation@1"
        },
        {
          "command": "mangabar.restartServer",
          "when": "view == mangabar.sidebarView",
          "group": "navigation@2"
        },
        {
          "command": "mangabar.openReader",
          "when": "view == mangabar.sidebarView",
          "group": "navigation@3"
        },
        {
          "command": "mangabar.stopServer",
          "when": "view == mangabar.sidebarView",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "MangaBar",
      "properties": {
        "mangabar.sideBarLocation": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "left",
          "description": "Docking location for MangaBar: primary left Activity Bar or secondary right Side Bar."
        },
        "mangabar.customServerUrl": {
          "type": "string",
          "default": "",
          "description": "Custom or remote MangaBar server URL (e.g., http://localhost:4567 or http://192.168.1.100:4567). When specified, connects directly without launching local server binaries."
        },
        "mangabar.serverPort": {
          "type": "number",
          "default": 4567,
          "description": "Port for MangaBar Server Engine (defaults to 4567 with auto fallback)"
        },
        "mangabar.dataDirectory": {
          "type": "string",
          "default": "./data",
          "description": "Directory where MangaBar stores library, database, and settings"
        },
        "mangabar.downloadDirectory": {
          "type": "string",
          "default": "./data/downloads",
          "description": "Directory for downloaded manga chapters"
        },
        "mangabar.autoStartServer": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the server when opening the MangaBar view"
        },
        "mangabar.extensionRepo": {
          "type": "string",
          "default": "https://raw.githubusercontent.com/keiyoushi/extensions/repo/index.min.json",
          "description": "Extension repository URL for manga sources"
        },
        "mangabar.serverDownloadUrl": {
          "type": "string",
          "default": "",
          "description": "Custom URL or mirror to download the MangaBar Server Engine binary"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js && node scripts/sync-extension.js",
    "watch": "node esbuild.js --watch",
    "sync-ext": "node scripts/sync-extension.js",
    "patch-webui": "node scripts/patch-webui.js",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.1",
    "typescript": "^5.4.5"
  }
}
